{
  "name": "lectura",
  "version": "1.1.2",
  "description": "PWA hors ligne : un personnage animé lit ton texte à côté d'un faux terminal.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node tools/serve.mjs",
    "dev": "vite --host",
    "build": "node tools/build.mjs",
    "preview": "node tools/serve.mjs dist",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "icons": "node tools/generate_icons.mjs",
    "characters": "node tools/build.mjs --index",
    "voice": "node tools/fetch_voice.mjs"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "onnxruntime-web": "^1.20.1",
    "prettier": "^3.3.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "lamejs": "^1.2.1",
    "mp4box": "^2.5.0"
  }
}
